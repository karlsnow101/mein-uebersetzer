{
  "manifest_version": 3,
  "name": "Mein Übersetzer",
  "version": "2.3.0",
  "description": "Markierten Text übersetzen; deutsche Texte werden ignoriert.",
  "permissions": [],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["panel.css"], "run_at": "document_idle"}],
  "background": {"service_worker": "background.js"}
}
